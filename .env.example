# Copy to .env, fill in real values, and keep .env out of git.
# Load it in PowerShell before running:
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }

# PostgreSQL connection. Percent-encode special characters in the password
# (@ becomes %40, # becomes %23, and so on).
OPS_KPI_DB_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres

# Folder the Excel reports are written into. Leave unset to keep the path
# already in OPS_KPI.py.
# OPS_KPI_BASE_FOLDER=J:\...\ops kpi

# Where the dashboard JSON is written. Defaults to data/ops_kpi_data.json
# next to OPS_KPI.py.
# OPS_KPI_JSON_PATH=C:\OPS_KPI_DASHBOARD\data\ops_kpi_data.json
